# Required: receives the CloudWatch alarms, and sends the e-mails while EMAIL_FROM is unset.
ALERT_EMAIL=

# Optional. Uncomment only the ones you use: an empty value is not the same as unset.
# EMAIL_FROM=no-reply@example.com
# DOMAIN=example.com
# DEPLOYMENT_ROLE_ARN=arn:aws:iam::123456789012:role/nutrail-api-cloudformation

# pnpm upload:meal (smoke test of a deployed stage)
BASE_URL=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
