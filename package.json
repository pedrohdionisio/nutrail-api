{
  "name": "nutrail-api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "serverless deploy",
    "dev:email": "email dev --dir src/infra/email/templates",
    "upload:meal": "node --env-file=.env scripts/uploadMeal.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-sesv2": "^3.1140.0",
    "@aws-sdk/client-sqs": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@aws-sdk/s3-presigned-post": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "reflect-metadata": "^0.2.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@swc/core": "^1.16.2",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "^0.28.2",
    "serverless": "^4.43.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  },
  "license": "UNLICENSED"
}
